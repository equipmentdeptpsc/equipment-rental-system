{
  "name": "equipmentrentalsystem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "test:server": "vitest run tests/deur-sync-http-server.test.ts tests/deur-sync-server-composition.test.ts tests/deur-sync-http-server-postgres.test.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "build:worker": "wrangler deploy --dry-run --outdir .worker-dist",
    "build": "tsc -b && vite build",
    "validate:env:uat": "node scripts/validate-uat-build.mjs",
    "build:uat": "node scripts/validate-uat-build.mjs && tsc -b && vite build",
    "test": "vitest run",
    "verify": "npm test && npx tsc --noEmit -p tsconfig.test.json && npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/vite": "^4.3.2",
    "exceljs": "^4.4.0",
    "jspdf": "^3.0.4",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
