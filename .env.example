# CLI/deployment only. Never expose these as VITE_ variables.
SUPABASE_ACCESS_TOKEN=replace-with-local-cli-token
SUPABASE_DB_PASSWORD=replace-with-development-database-password
SUPABASE_PROJECT_REF=replace-with-development-project-reference

# Browser-safe application configuration. Local remains the default.
VITE_PERSISTENCE_MODE=local
VITE_EQUIPMENT_STATUS_SOURCE=local
VITE_SUPABASE_URL=https://replace-with-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
# Keep broad remote operational writes disabled. These narrowly scoped flags
# enable only their canonical create commands when explicitly set to true.
VITE_REMOTE_OPERATIONAL_WRITES_ENABLED=false
VITE_REMOTE_RENTAL_CREATE_ENABLED=false
VITE_REMOTE_ASSIGNMENT_CREATE_ENABLED=false
VITE_REMOTE_ASSIGNMENT_CANCEL_ENABLED=false
VITE_REMOTE_PROJECT_CUSTOMER_LINK_ENABLED=false

# Node-only Phase C2 integration harness. Never expose the service key through VITE_*.
RUN_SUPABASE_INTEGRATION_TESTS=false
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SERVICE_KEY=
SUPABASE_TEST_ENVIRONMENT_ID=
SUPABASE_TEST_PROJECT_REF=
ALLOW_SUPABASE_TEST_MUTATION=false

# Server-only notification delivery. REVIEW_PUBLIC_BASE_URL is the deployed
# application origin used to construct customer and manager review links.
REVIEW_PUBLIC_BASE_URL=https://replace-with-application-origin.example
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
EMAIL_UAT_RECIPIENT_OVERRIDE=
